{
  "manifest_version": 3,
  "name": "Tradutor Rápido Ctrl + Áudio",
  "version": "2.0",
  "description": "Ouça o texto em inglês (clique ou Alt) e aperte Ctrl para traduzir para PT-BR.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}